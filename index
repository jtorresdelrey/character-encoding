    <script>
        const bitContainer = document.getElementById('bit-container');
        const decimalDisplay = document.getElementById('decimal-display');
        const hexDisplay = document.getElementById('hex-display');
        const binaryDisplayFormatted = document.getElementById('binary-display-formatted');
        let bits = [0, 0, 0, 0, 0, 0, 0, 0];

        function renderBits() {
            bitContainer.innerHTML = '';
            bits.forEach((bit, index) => {
                const val = Math.pow(2, 7 - index);
                const btn = document.createElement('div');
                btn.className = `bit-switch w-12 h-20 border-2 rounded-xl flex flex-col justify-end items-center cursor-pointer shadow-sm ${bit ? 'active' : 'bg-white border-stone-200'}`;
                btn.onclick = () => { bits[index] = bits[index] ? 0 : 1; renderBits(); };
                const label = document.createElement('span');
                label.className = `text-[11px] font-bold mb-2 ${bit ? 'text-white' : 'text-stone-400'}`;
                label.innerText = val;
                btn.innerHTML = `<div class="w-3 h-3 rounded-full mb-3 ${bit ? 'bg-white shadow-[0_0_8px_white]' : 'bg-stone-100'}"></div>`;
                btn.appendChild(label);
                bitContainer.appendChild(btn);
            });
            const decimal = parseInt(bits.join(''), 2);
            decimalDisplay.innerText = decimal;
            hexDisplay.innerText = decimal.toString(16).toUpperCase().padStart(2, '0');
            const bStr = bits.join('');
            binaryDisplayFormatted.innerText = bStr.substring(0,4) + ' ' + bStr.substring(4);
        }

        function simulate() {
            const text = document.getElementById('inputText').value;
            const lowerText = text.toLowerCase();
            const saveEnc = document.getElementById('saveEncoding').value;
            const readEnc = document.getElementById('readEncoding').value;
            const visor = document.getElementById('byte-stream-display');
            const analysis = document.getElementById('analysis-box');
            const explanation = document.getElementById('byte-explanation');
            
            visor.innerHTML = '';
            let allBytes = [];
            
            let individualInterpretDecoder;
            try {
                individualInterpretDecoder = new TextDecoder(readEnc);
            } catch (e) {
                individualInterpretDecoder = new TextDecoder('windows-1252');
            }

            for (let char of lowerText) {
                let charBytes;
                const codePoint = char.charCodeAt(0);

                if (saveEnc === 'UTF-8') {
                    charBytes = new TextEncoder().encode(char);
                } else {
                    charBytes = simpleAnsiEncode(char);
                }
                
                const charGroup = document.createElement('div');
                charGroup.className = "flex flex-col items-center gap-2 border-2 border-stone-100 p-4 rounded-2xl bg-white shadow-sm hover:border-indigo-200 transition";
                
                // --- RESTORED: Character Label ---
                const charLabel = document.createElement('div');
                charLabel.className = "text-xs font-black text-indigo-500 uppercase tracking-tighter mb-1";
                let labelText = char === " " ? "espacio" : `'${char}'`;
                // Optional: Show code point if multibyte
                if (charBytes.length > 1 && saveEnc === 'UTF-8') {
                    labelText += ` <span class="text-stone-400 font-normal">(${codePoint})</span>`;
                }
                charLabel.innerHTML = labelText;
                charGroup.appendChild(charLabel);
                // ---------------------------------

                const bytesContainer = document.createElement('div');
                bytesContainer.className = "flex gap-3";

                charBytes.forEach((b, idx) => {
                    const card = document.createElement('div');
