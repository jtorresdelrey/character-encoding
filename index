                                <div class="font-mono text-indigo-600 font-bold text-base">xC3 xB1</div>
                                <div class="font-mono text-[10px] text-stone-400 leading-tight">
                                    B1: <span class="bit-control">110</span><span class="bit-data">00011</span> / B2: <span class="bit-control">10</span><span class="bit-data">110001</span>
